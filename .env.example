PORT=3000
HOST=0.0.0.0
API_TOKEN=replace-with-a-long-random-token

ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
# Keep the Icecast listener mounted at /stream for the public radio URL.
ICECAST_MOUNT=/stream
ICECAST_SOURCE_USER=source
ICECAST_PASSWORD=replace-with-icecast-source-password
# Set this to the public listener URL when deploying to a VPS or tunnel.
PUBLIC_STREAM_URL=
# Optional local promo audio used by the bot's -promote whisper command.
PROMOTION_TRACK_FILE=./songs/promotion.mp3

# Optional yt-dlp support for YouTube sign-in protected results.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
# Optional ffmpeg install path when ffmpeg is not on PATH.
FFMPEG_LOCATION=

SONGS_DIR=./songs
LOG_DIR=./logs
PROMOTION_TRACK_DURATION_SECONDS=3

CACHE_MAX_TRACKS=20
CACHE_MAX_AGE_HOURS=12
CACHE_MAX_AGE_DAYS=30

STREAM_BITRATE=64k
STREAM_SAMPLE_RATE=44100
STREAM_CHANNELS=2

YTDLP_BIN=yt-dlp
YTDLP_EXTRACTOR_ARGS=
YTDLP_EXTRA_ARGS=
# Optional JS runtime for yt-dlp on Linux/WSL.
YTDLP_JS_RUNTIME=
# Optional remote challenge component distribution for yt-dlp on Linux/WSL.
YTDLP_REMOTE_COMPONENTS=
YTDLP_SEARCH_RESULTS=1
MAX_TRACK_DURATION=480

# Optional hard caps for lower VPS load.
DOWNLOAD_MAX_CONCURRENT=1
MAX_DOWNLOAD_TIME=120
FFMPEG_THREADS=1
MAX_QUEUE_SIZE=20
RESOURCE_CPU_LIMIT_PERCENT=85
RESOURCE_MEMORY_LIMIT_PERCENT=85